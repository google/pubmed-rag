# Copy to agents/.env and fill in, or export these in your shell.
# Only PROJECT_ID is required; every other value has a working default.

# --- Required -----------------------------------------------------------
PROJECT_ID=your-gcp-project-id

# --- Model ---------------------------------------------------------------
# Vertex region for Gemini. "global" is correct for gemini-3.6-flash.
LOCATION=global

# Agent reasoning model.
MODEL_ID=gemini-3.6-flash

# Per-article metadata extraction. Runs once per article, so a fast model
# matters more here than at the reasoning layer.
SCORING_MODEL_ID=gemini-3.6-flash

# --- BigQuery ------------------------------------------------------------
# Dataset created by agents/setup_bigquery.py.
BQ_DATASET=pubmed_demo

# Must be US: the public PubMed dataset lives in the US multi-region and
# vector search cannot cross locations.
BQ_LOCATION=US

# Source corpus. Ships with precomputed 768-dimension embeddings.
PUBMED_TABLE=bigquery-public-data.pmc_open_access_commercial.articles

# Embedding model for the query side. Must produce 768 dimensions to match the
# corpus. Do not switch to gemini-embedding-001 (3072) without re-embedding
# the corpus, which you cannot do for a public read-only table.
EMBEDDING_ENDPOINT=text-embedding-005
